<INFO name="JOBNAME" value=""/>
<INFO name="QUERY_STATUS" value="OK"/>
<INFO name="QUERY" value="SELECT TOP 1000
    source_id,
    ra,
    dec,
    parallax,
    parallax_error,
    phot_g_mean_mag,
    phot_bp_mean_mag,
    phot_rp_mean_mag,
    bp_rp,
    ruwe
FROM gaiadr3.gaia_source
WHERE parallax IS NOT NULL
  AND phot_g_mean_mag IS NOT NULL
  AND bp_rp IS NOT NULL" ucd="meta.query"/>

